# ==============================================================================
# Local Development:
# ==============================================================================
# Leave as localhost:1999 when running `npm run dev` and `npm run dev:party`
VITE_PARTYKIT_HOST=localhost:1999

# ==============================================================================
# Production (Netlify / Cloudflare):
# ==============================================================================
# In Netlify Dashboard -> Site Configuration -> Environment Variables:
# Add VITE_PARTYKIT_HOST with your PartyKit Cloud domain (or server domain)
# Example:
# VITE_PARTYKIT_HOST=wcdonalds-anomaly.YOUR_USERNAME.partykit.dev
